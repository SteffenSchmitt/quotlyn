{
  "name": "quotlyn",
  "private": true,
  "version": "1.3.7",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,proxy -c cyan,magenta \"npm:dev:web\" \"npm:dev:proxy\"",
    "dev:web": "vite --host 0.0.0.0 --port 5173",
    "dev:proxy": "node proxy/server.mjs",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/lato": "^5.3.0",
    "echarts": "^6.1.0",
    "idb": "^8.0.3",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-echarts": "^8.3.0",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.5",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.11"
  },
  "license": "MIT"
}
